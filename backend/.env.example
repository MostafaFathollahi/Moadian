# Copy to .env. Never commit the real thing — .gitignore already excludes it.

# --- signing material -------------------------------------------------------
# Where the server reads certificates and private keys from. An operator places
# files here out of band (scp, a mounted secret, config management); nothing is
# ever uploaded through the API, so a private key never appears in a request
# body, a proxy buffer or a browser tab.
#
#   mkdir -p instance/keys && cp mykey.pem mycert.crt instance/keys/
#   chmod 600 instance/keys/mykey.pem
#
# A profile then refers to these by bare filename.
MOADIAN_KEY_DIR=instance/keys

# Optional. Set this if the private key is an ENCRYPTED PKCS#8 file, which is
# the recommended setup: the key is then encrypted at rest *and* never transits
# the application. Leave unset for an unencrypted key protected by file mode.
#   openssl pkcs8 -topk8 -in plain.pem -out encrypted.pem
# MOADIAN_KEY_PASSPHRASE=

# --- profile store ----------------------------------------------------------
# Unlocks the encrypted store holding which memory id uses which key files and
# which environment. Required; the API refuses to start without it.
MOADIAN_MASTER_PASSPHRASE=change-me

# --- storage ----------------------------------------------------------------
# Profile store, per-memory serial counters, and the local record database.
MOADIAN_INSTANCE_DIR=instance

# --- service ----------------------------------------------------------------
# Both are pinned in WIRE_FORMAT.md; override only to reach a proxy or a mock.
# MOADIAN_SANDBOX_BASE_URL=https://sandboxrc.tax.gov.ir/requestsmanager
# MOADIAN_PRODUCTION_BASE_URL=https://tp.tax.gov.ir/requestsmanager
MOADIAN_REQUEST_TIMEOUT_SECONDS=60
# Seconds, 10-200. Observed behaviour is that the service grants this plus 30,
# so treat the response expDate as authoritative.
MOADIAN_NONCE_TIME_TO_LIVE=30

# --- live tests -------------------------------------------------------------
# Used only by tests marked `live`, which are deselected by default.
# MOADIAN_TEST_ENVIRONMENT=sandbox
# MOADIAN_TEST_MEMORY_ID=A11216
