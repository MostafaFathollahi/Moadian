# Copy to .env. Never commit the real thing — .gitignore already excludes it.

# --- signing material -------------------------------------------------------
# The certificate and private key the server signs with. Set here and nowhere
# else: nothing about these paths is ever accepted over HTTP, so no key byte and
# no path ever appears in a request body, a proxy buffer or a browser tab.
#
# Place the files on the server out of band (scp, a mounted secret, config
# management) and lock the key down:
#
#   chmod 600 /secure/moadian/key.pem
#
MOADIAN_CERTIFICATE_PATH=/secure/moadian/cert.crt
MOADIAN_PRIVATE_KEY_PATH=/secure/moadian/key.pem

# Per-environment overrides. Use these once production has a CA-issued
# certificate and sandbox is still on a test one — which is the normal state of
# affairs while the CA paperwork is in progress. Unset values fall back to the
# pair above.
# MOADIAN_SANDBOX_CERTIFICATE_PATH=/secure/moadian/sandbox.crt
# MOADIAN_SANDBOX_PRIVATE_KEY_PATH=/secure/moadian/sandbox.pem
# MOADIAN_PRODUCTION_CERTIFICATE_PATH=/secure/moadian/prod.crt
# MOADIAN_PRODUCTION_PRIVATE_KEY_PATH=/secure/moadian/prod.pem

# Optional, and recommended: the passphrase of an ENCRYPTED PKCS#8 private key.
# With this set the key is encrypted at rest *and* never transits the app.
#   openssl pkcs8 -topk8 -in plain.pem -out encrypted.pem
# MOADIAN_KEY_PASSPHRASE=

# --- profile store ----------------------------------------------------------
# Unlocks the encrypted store of profiles (which memory id, which environment).
# Required; the API refuses to start without it. Holds no key material.
MOADIAN_MASTER_PASSPHRASE=change-me

# --- accounts and sessions --------------------------------------------------
# Signs the bearer tokens this app issues to its own users. NOT the tax-API
# signing key — that one is RSA and configured above. Unset means a random
# secret per process, which is safe but logs everyone out on restart.
MOADIAN_APP_SECRET=change-me-to-32-random-bytes
MOADIAN_TOKEN_TTL_HOURS=12

# Accounts created at first start, as "user:pass:role,user:pass:role".
# Existing users are never overwritten, so changing this cannot reset a
# password someone has since changed. CHANGE THE DEFAULT PASSWORD.
MOADIAN_SEED_USERS=admin:admin1234:admin

# --- storage ----------------------------------------------------------------
# Profile store, per-memory serial counters, and the local record database.
MOADIAN_INSTANCE_DIR=instance

# The built UI (frontend/dist). Set it and this process serves the UI and the
# API on one origin — one port, which is what a single service behind an SSH
# tunnel needs. Leave it unset in development, where Vite serves the UI and
# proxies /api here.
# MOADIAN_STATIC_DIR=/home/mstf/Moadian/frontend/dist

# --- service ----------------------------------------------------------------
# Both are pinned in WIRE_FORMAT.md; override only to reach a proxy or a mock.
# MOADIAN_SANDBOX_BASE_URL=https://sandboxrc.tax.gov.ir/requestsmanager
# MOADIAN_PRODUCTION_BASE_URL=https://tp.tax.gov.ir/requestsmanager
MOADIAN_REQUEST_TIMEOUT_SECONDS=60
# Seconds, 10-200. Observed behaviour is that the service grants this plus 30,
# so treat the response expDate as authoritative.
MOADIAN_NONCE_TIME_TO_LIVE=30

# --- live tests -------------------------------------------------------------
# Used only by tests marked `live`, which are deselected by default.
# MOADIAN_TEST_ENVIRONMENT=sandbox
# MOADIAN_TEST_MEMORY_ID=A11216
